{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "3.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "revision",
            "content_sha256"
          ],
          "additionalProperties": false
        }
      ]
    },
    "purpose": {
      "enum": [
        "reference",
        "fixture"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "object",
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "additionalProperties": false
        },
        "video_stream_index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "duration_s",
        "width",
        "height",
        "fps",
        "video_stream_index"
      ],
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "ai": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "model_build": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "provider",
            "model",
            "model_build"
          ],
          "additionalProperties": false
        },
        "reviewed_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "minimum": 0
              },
              "mode": {
                "enum": [
                  "sampling",
                  "frame-by-frame"
                ]
              }
            },
            "required": [
              "start_s",
              "end_s",
              "mode"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "frame_reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "shot_id": {
                "type": "string",
                "minLength": 1
              },
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "minimum": 0
              },
              "mode": {
                "enum": [
                  "sampling",
                  "frame-by-frame"
                ]
              },
              "sampling_fps": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0,
                "maximum": 240
              },
              "selected_frame_indices": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "viewed_frame_indices": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "shot_id",
              "start_s",
              "end_s",
              "mode",
              "sampling_fps",
              "selected_frame_indices",
              "viewed_frame_indices",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "method",
        "limitations",
        "ai",
        "reviewed_ranges",
        "frame_reviews"
      ],
      "additionalProperties": false
    },
    "audit_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "render": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": "3.0"
        },
        "template_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "font_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bold_font_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "layout_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "jpeg_quality": {
          "type": "integer",
          "minimum": 30,
          "maximum": 100
        },
        "panel_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "overview_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "storyboard_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "format_version",
        "template_sha256",
        "font_sha256",
        "bold_font_sha256",
        "layout_sha256",
        "jpeg_quality",
        "panel_scale",
        "columns",
        "overview_scale",
        "storyboard_scale"
      ],
      "additionalProperties": false
    },
    "frames": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_pointer": {
            "type": "string",
            "minLength": 1
          },
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "area_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "frame_index": {
            "type": "integer",
            "minimum": 0
          },
          "timestamp_s": {
            "type": "number",
            "minimum": 0
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "source_pointer",
          "shot_id",
          "area_ids",
          "frame_index",
          "timestamp_s",
          "role",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "shot-collage",
              "overview",
              "storyboard"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "panels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "selection_id": {
                  "type": "string",
                  "minLength": 1
                },
                "bbox": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    }
                  ],
                  "minItems": 4,
                  "maxItems": 4
                },
                "scale": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "selection_id",
                "bbox",
                "scale"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "shot_id": {
                  "type": "string",
                  "minLength": 1
                },
                "derived_from": {
                  "type": "string",
                  "minLength": 1
                },
                "bbox": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    }
                  ],
                  "minItems": 4,
                  "maxItems": 4
                }
              },
              "required": [
                "shot_id",
                "derived_from",
                "bbox"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "path",
          "kind",
          "width",
          "height",
          "sha256",
          "panels"
        ],
        "additionalProperties": false
      },
      "minItems": 3
    }
  },
  "required": [
    "contract_version",
    "id",
    "revision",
    "supersedes",
    "purpose",
    "source",
    "audit",
    "audit_sha256",
    "render",
    "frames",
    "selections",
    "media"
  ],
  "additionalProperties": false
}
