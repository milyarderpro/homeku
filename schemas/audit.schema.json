{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "design": {
      "$ref": "#/$defs/design"
    },
    "areas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/area"
      },
      "minItems": 1
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shot"
      },
      "minItems": 1
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      },
      "minItems": 0
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "design",
    "areas",
    "shots"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "claim": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "state": {
          "enum": [
            "observed",
            "uncertain",
            "not-visible",
            "not-present",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "state",
        "evidence"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "state": {
          "enum": [
            "observed",
            "uncertain",
            "not-visible",
            "not-present",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "attribute": {
          "type": "string",
          "minLength": 1
        },
        "facet_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "area_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "domain": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "state",
        "evidence",
        "subject",
        "attribute"
      ],
      "additionalProperties": false
    },
    "feature": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "state": {
          "enum": [
            "observed",
            "uncertain",
            "not-visible",
            "not-present",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "aspect": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "state",
        "evidence",
        "aspect"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "observed",
            "uncertain",
            "not-visible",
            "not-present",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "state",
        "evidence",
        "from",
        "to",
        "relation",
        "description"
      ],
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "properties": {
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "start_s",
        "end_s"
      ],
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "styles": {
          "type": "object",
          "properties": {
            "primary": {
              "$ref": "#/$defs/claim"
            },
            "influences": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/claim"
              },
              "minItems": 0
            },
            "interior": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/claim"
              },
              "minItems": 0
            },
            "relations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/relation"
              },
              "minItems": 0
            }
          },
          "required": [
            "primary",
            "influences",
            "interior"
          ],
          "additionalProperties": false
        },
        "size": {
          "type": "object",
          "properties": {
            "scale": {
              "$ref": "#/$defs/claim"
            },
            "levels": {
              "$ref": "#/$defs/claim"
            },
            "footprint": {
              "$ref": "#/$defs/claim"
            },
            "proportions": {
              "$ref": "#/$defs/claim"
            },
            "floor_area_m2": {
              "type": "object",
              "properties": {
                "min": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "min",
                "max"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "scale",
            "levels",
            "footprint",
            "proportions",
            "floor_area_m2"
          ],
          "additionalProperties": false
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          },
          "minItems": 0
        },
        "house_type": {
          "$ref": "#/$defs/house-type"
        },
        "palette": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/palette-color"
          }
        }
      },
      "required": [
        "name",
        "styles",
        "size",
        "features"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "house_type": [
          "palette"
        ],
        "palette": [
          "house_type"
        ]
      }
    },
    "category": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          },
          "minItems": 0
        }
      },
      "required": [
        "text",
        "facts"
      ],
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "properties": {
        "area_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "architecture": {
          "$ref": "#/$defs/category"
        },
        "furnishings": {
          "$ref": "#/$defs/category"
        },
        "environment": {
          "$ref": "#/$defs/category"
        }
      },
      "required": [
        "area_ids",
        "architecture",
        "furnishings",
        "environment"
      ],
      "additionalProperties": false
    },
    "composition": {
      "type": "object",
      "properties": {
        "camera_position": {
          "type": "string",
          "minLength": 1
        },
        "camera_direction": {
          "type": "string",
          "minLength": 1
        },
        "view_angle": {
          "type": "string",
          "minLength": 1
        },
        "camera_height": {
          "type": "string",
          "minLength": 1
        },
        "camera_tilt": {
          "type": "string",
          "minLength": 1
        },
        "foreground": {
          "type": "string",
          "minLength": 1
        },
        "depth": {
          "type": "string",
          "minLength": 1
        },
        "reveal": {
          "type": "string",
          "minLength": 1
        },
        "start_composition": {
          "type": "string",
          "minLength": 1
        },
        "end_composition": {
          "type": "string",
          "minLength": 1
        },
        "motion_compatibility": {
          "type": "string",
          "minLength": 1
        },
        "focus": {
          "type": "string",
          "minLength": 1
        },
        "lighting": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "camera_position",
        "camera_direction",
        "view_angle",
        "camera_height",
        "camera_tilt",
        "foreground",
        "depth",
        "reveal",
        "start_composition",
        "end_composition",
        "motion_compatibility",
        "focus",
        "lighting"
      ],
      "additionalProperties": false
    },
    "phase": {
      "type": "object",
      "properties": {
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        },
        "notation": {
          "type": "string",
          "minLength": 1
        },
        "depth_direction": {
          "enum": [
            "IN",
            "OUT",
            "NO IN/OUT",
            null
          ]
        },
        "focus": {
          "type": "string",
          "minLength": 1
        },
        "area_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "observations": {
          "type": "object",
          "properties": {
            "depth": {
              "type": "string",
              "minLength": 1
            },
            "translation": {
              "type": "string",
              "minLength": 1
            },
            "rotation": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "depth",
            "translation",
            "rotation"
          ],
          "additionalProperties": false
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "speed_change": {
          "enum": [
            "constant",
            "accelerating",
            "decelerating",
            "variable",
            "unknown"
          ]
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "component_index": {
                "type": "integer",
                "minimum": 0
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "component_index"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "start_s",
        "end_s",
        "notation",
        "depth_direction",
        "focus",
        "evidence",
        "observations"
      ],
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "properties": {
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        },
        "label": {
          "enum": [
            "slow",
            "moderate",
            "fast",
            "unknown"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "start_s",
        "end_s",
        "label",
        "description"
      ],
      "additionalProperties": false
    },
    "tempo": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "label": {
              "enum": [
                "slow",
                "moderate",
                "fast",
                "unknown"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "label",
            "description"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "segments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/segment"
              },
              "minItems": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "segments",
            "description"
          ],
          "additionalProperties": false
        }
      ]
    },
    "camera": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phase"
          },
          "minItems": 1
        },
        "tempo": {
          "$ref": "#/$defs/tempo"
        },
        "journey": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "description",
        "phases",
        "tempo"
      ],
      "additionalProperties": false
    },
    "panel": {
      "type": "object",
      "properties": {
        "frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "area_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "frame_index",
        "area_ids"
      ],
      "additionalProperties": false
    },
    "overview": {
      "type": "object",
      "properties": {
        "frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "area_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "composition_summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "frame_index",
        "area_ids",
        "composition_summary"
      ],
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "properties": {
        "area_id": {
          "type": "string",
          "minLength": 1
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        },
        "connector": {
          "type": "string",
          "minLength": 1
        },
        "focus": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "area_id",
        "start_s",
        "end_s",
        "connector",
        "focus"
      ],
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "properties": {
        "shot": {
          "type": "string",
          "pattern": "^shot-[0-9]{2,}$"
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        },
        "transition": {
          "type": "string",
          "minLength": 1
        },
        "continuity": {
          "type": "string",
          "minLength": 1
        },
        "area_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "route": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          },
          "minItems": 0
        },
        "area_relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          },
          "minItems": 0
        },
        "design": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          },
          "minItems": 1
        },
        "composition": {
          "$ref": "#/$defs/composition"
        },
        "camera": {
          "$ref": "#/$defs/camera"
        },
        "panels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/panel"
          },
          "minItems": 2
        },
        "overviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overview"
          },
          "minItems": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "shot",
        "start_s",
        "end_s",
        "transition",
        "area_ids",
        "design",
        "composition",
        "camera",
        "panels",
        "overviews"
      ],
      "additionalProperties": false
    },
    "area": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "visible_intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interval"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "label",
        "functions",
        "visible_intervals"
      ],
      "additionalProperties": false
    },
    "house-type": {
      "$ref": "#/$defs/claim",
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "state": {
          "enum": [
            "observed",
            "uncertain",
            "unknown"
          ]
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": "string"
          }
        }
      }
    },
    "palette-color": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "hex": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "state": {
          "enum": [
            "observed",
            "uncertain"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "value",
        "role",
        "hex",
        "state",
        "evidence"
      ],
      "additionalProperties": false
    }
  }
}
