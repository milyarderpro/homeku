{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "method": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    },
    "ai": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_build": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "provider",
        "model",
        "model_build"
      ],
      "additionalProperties": false
    },
    "reviewed_ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "mode": {
            "enum": [
              "sampling",
              "frame-by-frame"
            ]
          }
        },
        "required": [
          "start_s",
          "end_s",
          "mode"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "frame_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "mode": {
            "enum": [
              "sampling",
              "frame-by-frame"
            ]
          },
          "sampling_fps": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "maximum": 240
          },
          "selected_frame_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "viewed_frame_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "shot_id",
          "start_s",
          "end_s",
          "mode",
          "sampling_fps",
          "selected_frame_indices",
          "viewed_frame_indices",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "method",
    "limitations",
    "ai",
    "reviewed_ranges",
    "frame_reviews"
  ],
  "additionalProperties": false
}
