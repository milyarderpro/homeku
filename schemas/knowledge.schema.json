{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOMEKU knowledge contracts",
  "description": "Local contracts for derived data. Source analysis remains schema 2.1. Review and observation contracts are reserved for later phases; no review events are inferred.",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "reference_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "analysis_path": {
          "type": "string",
          "pattern": "^references/[A-Za-z0-9][A-Za-z0-9_.-]*/analysis\\.yaml$"
        },
        "analysis_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_path": {
          "type": "string",
          "pattern": "^video/[A-Za-z0-9][A-Za-z0-9_.-]*\\.mp4$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "reference_id",
        "analysis_path",
        "analysis_sha256",
        "source_path",
        "source_sha256"
      ],
      "additionalProperties": false
    },
    "normalization": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "taxonomy_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "taxonomy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mapping"
          }
        }
      },
      "required": [
        "schema_version",
        "taxonomy_version",
        "taxonomy_sha256",
        "source",
        "mappings"
      ],
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "field_path": {
          "type": "string",
          "pattern": "^/"
        },
        "shot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw": {},
        "presence": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "mapped",
            "ambiguous",
            "unmapped",
            "unknown",
            "not_visible",
            "not_applicable",
            "missing",
            "empty"
          ]
        },
        "coverage": {
          "enum": [
            "exact",
            "partial",
            "none"
          ]
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "concept_id": {
                "type": "string",
                "minLength": 1
              },
              "dimension": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "concept_id",
              "dimension"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "concept_id": {
                "type": "string",
                "minLength": 1
              },
              "dimension": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "concept_id",
              "dimension"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "field_path",
        "shot_id",
        "raw",
        "presence",
        "state",
        "coverage",
        "matches",
        "candidates",
        "qualifiers",
        "reason"
      ],
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "release_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "published_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "taxonomy_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "taxonomy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reference_count": {
          "type": "integer",
          "minimum": 1
        },
        "shot_count": {
          "type": "integer",
          "minimum": 1
        },
        "visual_detail_count": {
          "type": "integer",
          "minimum": 0
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "required": [
        "schema_version",
        "release_id",
        "published_on",
        "taxonomy_version",
        "taxonomy_sha256",
        "reference_count",
        "shot_count",
        "visual_detail_count",
        "references"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "method": {
          "enum": [
            "ai_visual_review",
            "ai_consistency_review"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_on": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field_path": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "supported",
                  "incorrect",
                  "ambiguous",
                  "unknown"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "field_path",
              "status",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "id",
        "source",
        "method",
        "reviewer",
        "reviewed_on",
        "scope",
        "findings"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "shot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "field_path": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "claim_type": {
          "enum": [
            "OBSERVATION",
            "INFERENCE",
            "DESIGN_PRINCIPLE"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schema_version",
        "id",
        "source",
        "shot_id",
        "field_path",
        "statement",
        "claim_type",
        "confidence",
        "limitations"
      ],
      "additionalProperties": false
    },
    "aggregate": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "release_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "claim_type": {
          "const": "AGGREGATE"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "measurement": {
          "type": "string",
          "minLength": 1
        },
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        },
        "reference_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "uniqueItems": true
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schema_version",
        "id",
        "release_id",
        "claim_type",
        "statement",
        "measurement",
        "numerator",
        "denominator",
        "reference_ids",
        "exceptions",
        "limitations"
      ],
      "additionalProperties": false
    }
  }
}
