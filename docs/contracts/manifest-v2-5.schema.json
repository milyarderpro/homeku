{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOMEKU manifest 2.5",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "2.5"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "revision",
            "content_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "object",
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "additionalProperties": false
        },
        "video_stream_index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "duration_s",
        "width",
        "height",
        "fps",
        "video_stream_index"
      ],
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_ranges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "mode": {
                "enum": [
                  "sampling",
                  "playback",
                  "frame-by-frame"
                ]
              }
            },
            "required": [
              "start_s",
              "end_s",
              "mode"
            ],
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "ai": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "model_build": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "provider",
            "model",
            "model_build"
          ],
          "additionalProperties": false
        },
        "frame_reviews": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "shot_id": {
                "type": "string",
                "pattern": "^shot-[0-9]{2,}$"
              },
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "mode": {
                "enum": [
                  "sampling",
                  "frame-by-frame"
                ]
              },
              "sampling_fps": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0.001,
                "maximum": 240
              },
              "selected_frame_indices": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "viewed_frame_indices": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "shot_id",
              "start_s",
              "end_s",
              "mode",
              "sampling_fps",
              "selected_frame_indices",
              "viewed_frame_indices",
              "reason"
            ]
          }
        }
      },
      "required": [
        "method",
        "reviewed_ranges",
        "limitations",
        "created_at",
        "ai",
        "frame_reviews"
      ],
      "additionalProperties": false
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "storyboard",
              "shot-collage",
              "overview"
            ]
          },
          "shot_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "panels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                },
                "selection_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                },
                "shot_id": {
                  "type": "string",
                  "pattern": "^shot-[0-9]{2,}$"
                },
                "area_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
                  },
                  "minItems": 1
                },
                "frame_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "timestamp_s": {
                  "type": "number",
                  "minimum": 0
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "scale": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "id",
                "selection_id",
                "shot_id",
                "area_ids",
                "frame_index",
                "timestamp_s",
                "bbox",
                "scale"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "shot_id": {
                  "type": "string",
                  "pattern": "^shot-[0-9]{2,}$"
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "scale": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "derived_from": {
                  "type": "string",
                  "pattern": "^media/shot-[0-9]{2,}\\.jpg$"
                }
              },
              "required": [
                "shot_id",
                "bbox",
                "scale",
                "derived_from"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "path",
          "sha256",
          "kind",
          "shot_id",
          "width",
          "height",
          "panels",
          "blocks"
        ],
        "additionalProperties": false
      },
      "minItems": 3
    },
    "purpose": {
      "enum": [
        "reference",
        "fixture"
      ]
    },
    "audit_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "render": {
      "type": "object",
      "properties": {
        "report": {
          "const": "2.2.4"
        },
        "template_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media": {
          "const": "2.2.1"
        },
        "font_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "jpeg_quality": {
          "type": "integer",
          "minimum": 60,
          "maximum": 98
        },
        "panel_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "bold_font_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "overview_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "storyboard_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "layout_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "report",
        "template_sha256",
        "media",
        "font_sha256",
        "jpeg_quality",
        "panel_scale",
        "columns",
        "bold_font_sha256",
        "overview_scale",
        "storyboard_scale",
        "layout_sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "id",
    "revision",
    "supersedes",
    "source",
    "audit",
    "media",
    "purpose",
    "audit_sha256",
    "render"
  ],
  "additionalProperties": false,
  "$id": "https://homeku.local/contracts/manifest-v2-1.schema.json"
}
