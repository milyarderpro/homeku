{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOMEKU provisional manifest 1.0",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "revision",
            "content_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "object",
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1
            },
            "denominator": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "additionalProperties": false
        },
        "video_stream_index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "duration_s",
        "width",
        "height",
        "fps",
        "video_stream_index"
      ],
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_ranges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "mode": {
                "enum": [
                  "sampling",
                  "playback",
                  "frame-by-frame"
                ]
              }
            },
            "required": [
              "start_s",
              "end_s",
              "mode"
            ],
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "ai": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "model_build": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "provider",
            "model",
            "model_build"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "method",
        "reviewed_ranges",
        "limitations",
        "created_at",
        "ai"
      ],
      "additionalProperties": false
    },
    "media": {
      "type": "array",
      "minItems": 5,
      "maxItems": 1998,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "storyboard",
              "area-overview",
              "start",
              "middle",
              "end",
              "reveal",
              "detail"
            ]
          },
          "shot_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^shot-[0-9]{2,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "timestamp_s": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "crop": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 4,
                "maxItems": 4
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "kind",
          "shot_id",
          "timestamp_s",
          "width",
          "height",
          "derived_from",
          "crop"
        ],
        "additionalProperties": false
      }
    },
    "purpose": {
      "enum": [
        "reference",
        "fixture"
      ]
    }
  },
  "required": [
    "contract_version",
    "id",
    "revision",
    "supersedes",
    "source",
    "audit",
    "media",
    "purpose"
  ],
  "additionalProperties": false
}
