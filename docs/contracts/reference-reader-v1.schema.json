{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOMEKU AI reference reader 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "reference",
    "paths",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "homeku.reference"
    },
    "reference": {
      "type": "object",
      "required": [
        "format_version",
        "id",
        "revision",
        "title",
        "summary",
        "coverage",
        "profile",
        "profile_notes",
        "palette_notes",
        "timeline_notes",
        "shots",
        "relations",
        "limitations",
        "links",
        "source",
        "media",
        "audit",
        "content_sha256"
      ],
      "properties": {
        "format_version": {
          "enum": [
            "1.0",
            "1.1"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "profile": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "value",
              "state",
              "confidence",
              "evidence",
              "aspect"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "observed",
                  "uncertain",
                  "not-visible",
                  "not-present",
                  "unknown"
                ]
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "unknown"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "aspect": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "shot",
              "start_s",
              "end_s",
              "areas",
              "transition",
              "continuity",
              "composition",
              "facts",
              "camera_summary",
              "phases",
              "design",
              "uncertainty",
              "review_summary",
              "composition_notes",
              "camera_notes"
            ],
            "properties": {
              "shot": {
                "type": "string",
                "minLength": 1
              },
              "start_s": {
                "type": "number"
              },
              "end_s": {
                "type": "number"
              },
              "areas": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "composition": {
                "type": "object",
                "required": [
                  "overview_timestamp_s",
                  "overview_role",
                  "overview_reason",
                  "overview_exception",
                  "camera_position",
                  "camera_direction",
                  "view_angle",
                  "camera_height",
                  "camera_tilt",
                  "foreground",
                  "depth",
                  "reveal",
                  "start_composition",
                  "end_composition",
                  "motion_compatibility"
                ],
                "additionalProperties": false,
                "properties": {
                  "overview_timestamp_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "overview_role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "overview_reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "overview_exception": {
                    "type": "string",
                    "minLength": 1
                  },
                  "camera_position": {
                    "type": "string",
                    "minLength": 1
                  },
                  "camera_direction": {
                    "type": "string",
                    "minLength": 1
                  },
                  "view_angle": {
                    "type": "string",
                    "minLength": 1
                  },
                  "camera_height": {
                    "type": "string",
                    "minLength": 1
                  },
                  "camera_tilt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "foreground": {
                    "type": "string",
                    "minLength": 1
                  },
                  "depth": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reveal": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start_composition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "end_composition": {
                    "type": "string",
                    "minLength": 1
                  },
                  "motion_compatibility": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "facts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "value",
                    "state",
                    "confidence",
                    "evidence",
                    "domain",
                    "subject",
                    "attribute"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "state": {
                      "enum": [
                        "observed",
                        "uncertain",
                        "not-visible",
                        "not-present",
                        "unknown"
                      ]
                    },
                    "confidence": {
                      "enum": [
                        "high",
                        "medium",
                        "low",
                        "unknown"
                      ]
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "domain": {
                      "type": "string",
                      "minLength": 1
                    },
                    "subject": {
                      "type": "string",
                      "minLength": 1
                    },
                    "attribute": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "phases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "phase",
                    "start_s",
                    "end_s",
                    "components",
                    "anchor",
                    "tempo",
                    "speed_change",
                    "basis",
                    "evidence",
                    "confidence",
                    "uncertainty",
                    "components_parsed"
                  ],
                  "properties": {
                    "phase": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start_s": {
                      "type": "number"
                    },
                    "end_s": {
                      "type": "number"
                    },
                    "components": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tempo": {
                      "enum": [
                        "slow",
                        "moderate",
                        "fast",
                        "variable",
                        "unknown"
                      ]
                    },
                    "components_parsed": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "raw",
                          "movement",
                          "direction",
                          "qualifiers",
                          "estimates",
                          "toward"
                        ],
                        "properties": {
                          "raw": {
                            "type": "string",
                            "minLength": 1
                          },
                          "movement": {
                            "type": "string",
                            "minLength": 1
                          },
                          "direction": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "qualifiers": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "estimates": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "toward": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "anchor": {
                      "type": "string",
                      "minLength": 1
                    },
                    "basis": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uncertainty": {
                      "type": "string",
                      "minLength": 1
                    },
                    "speed_change": {
                      "enum": [
                        "accelerating",
                        "decelerating",
                        "constant",
                        "variable",
                        "unknown"
                      ]
                    },
                    "confidence": {
                      "enum": [
                        "high",
                        "medium",
                        "low",
                        "unknown"
                      ]
                    }
                  }
                }
              },
              "camera_summary": {
                "type": "string",
                "minLength": 1
              },
              "design": {
                "type": "string",
                "minLength": 1
              },
              "uncertainty": {
                "type": "string",
                "minLength": 1
              },
              "review_summary": {
                "type": "string",
                "minLength": 1
              },
              "composition_notes": {
                "type": "string"
              },
              "camera_notes": {
                "type": "string"
              },
              "transition": {
                "type": "string",
                "minLength": 1
              },
              "continuity": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "source": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "duration_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "fps": {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "integer",
                  "minimum": 1
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "numerator",
                "denominator"
              ],
              "additionalProperties": false
            },
            "video_stream_index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "path",
            "sha256",
            "duration_s",
            "width",
            "height",
            "fps",
            "video_stream_index"
          ],
          "additionalProperties": false
        },
        "media": {
          "type": "array",
          "minItems": 5,
          "maxItems": 1998,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "kind": {
                "enum": [
                  "storyboard",
                  "area-overview",
                  "start",
                  "middle",
                  "end",
                  "reveal",
                  "detail"
                ]
              },
              "shot_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^shot-[0-9]{2,}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "timestamp_s": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "derived_from": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "crop": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "path",
              "sha256",
              "kind",
              "shot_id",
              "timestamp_s",
              "width",
              "height",
              "derived_from",
              "crop"
            ],
            "additionalProperties": false
          }
        },
        "audit": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "reviewed_ranges": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "start_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end_s": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "mode": {
                    "enum": [
                      "sampling",
                      "playback",
                      "frame-by-frame"
                    ]
                  }
                },
                "required": [
                  "start_s",
                  "end_s",
                  "mode"
                ],
                "additionalProperties": false
              }
            },
            "limitations": {
              "type": "string",
              "minLength": 1
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "ai": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "model_build": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "provider",
                "model",
                "model_build"
              ],
              "additionalProperties": false
            },
            "frame_reviews": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "shot_id": {
                    "type": "string",
                    "pattern": "^shot-[0-9]{2,}$"
                  },
                  "start_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end_s": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "mode": {
                    "enum": [
                      "sampling",
                      "frame-by-frame"
                    ]
                  },
                  "sampling_fps": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 10,
                    "maximum": 240
                  },
                  "selected_frame_indices": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "viewed_frame_indices": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false,
                "required": [
                  "shot_id",
                  "start_s",
                  "end_s",
                  "mode",
                  "sampling_fps",
                  "selected_frame_indices",
                  "viewed_frame_indices",
                  "reason"
                ]
              }
            }
          },
          "required": [
            "method",
            "reviewed_ranges",
            "limitations",
            "created_at",
            "ai"
          ],
          "additionalProperties": false
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "profile_notes": {
          "type": "string"
        },
        "palette_notes": {
          "type": "string"
        },
        "timeline_notes": {
          "type": "string"
        },
        "limitations": {
          "type": "string"
        },
        "coverage": {
          "type": "object",
          "required": [
            "method",
            "limitations"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "limitations": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "relation",
              "description",
              "state",
              "confidence",
              "evidence"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "observed",
                  "uncertain",
                  "not-visible",
                  "not-present",
                  "unknown"
                ]
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "unknown"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "required": [
        "analysis",
        "manifest",
        "source"
      ],
      "properties": {
        "analysis": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "md"
        ]
      }
    }
  }
}
