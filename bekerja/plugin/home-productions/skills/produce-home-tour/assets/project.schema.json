{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:home-productions:project:2.0",
  "title": "home-productions R2V project",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "rules_version": {
      "const": "2.0.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "stage": {
      "enum": [
        "brief",
        "concept",
        "shot_plan",
        "image_prompt_package",
        "image_draft",
        "image_final",
        "prompt_package"
      ]
    },
    "brief": {
      "type": "string"
    },
    "concept": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "summary"
      ],
      "additionalProperties": false
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "repository_url": {
          "type": "string",
          "pattern": "\\S"
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "route": {
          "enum": [
            "web",
            "github_connector",
            null
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0
        }
      },
      "required": [
        "repository_url",
        "ref",
        "commit",
        "route",
        "evidence"
      ],
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "properties": {
        "architecture": {
          "type": "string"
        },
        "layout": {
          "type": "string"
        },
        "ceiling": {
          "type": "string"
        },
        "materials": {
          "type": "string"
        },
        "lighting": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "anchors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "architecture",
        "layout",
        "ceiling",
        "materials",
        "lighting",
        "environment",
        "connections",
        "anchors"
      ],
      "additionalProperties": false
    },
    "image_mode": {
      "enum": [
        null,
        "prompt_to_image",
        "generate_image"
      ]
    },
    "image_batch": {
      "type": "object",
      "properties": {
        "request_mode": {
          "enum": [
            "all_at_once",
            "one_by_one"
          ]
        },
        "execution": {
          "enum": [
            "not_started",
            "parallel",
            "sequential",
            "external",
            "unknown"
          ]
        },
        "user_instruction": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "request_mode",
        "execution",
        "user_instruction",
        "note"
      ],
      "additionalProperties": false
    },
    "video": {
      "type": "object",
      "properties": {
        "method": {
          "const": "R2V"
        },
        "aspect_ratio": {
          "const": "9:16"
        }
      },
      "required": [
        "method",
        "aspect_ratio"
      ],
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "pattern": "\\S"
        },
        "music": {
          "type": "boolean"
        },
        "narration": {
          "type": "boolean"
        },
        "dialogue": {
          "type": "boolean"
        },
        "dramatic_effects": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "music",
        "narration",
        "dialogue",
        "dramatic_effects"
      ],
      "additionalProperties": false
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shot"
      },
      "minItems": 0
    },
    "image_plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/image"
      },
      "minItems": 0
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "minItems": 0
    },
    "approvals": {
      "type": "object",
      "properties": {
        "concept": {
          "anyOf": [
            {
              "$ref": "#/$defs/approval"
            },
            {
              "type": "null"
            }
          ]
        },
        "shot_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/approval"
            },
            {
              "type": "null"
            }
          ]
        },
        "visual": {
          "anyOf": [
            {
              "$ref": "#/$defs/approval"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "concept",
        "shot_plan",
        "visual"
      ],
      "additionalProperties": false
    },
    "total_duration_s": {
      "type": "integer",
      "minimum": 0
    },
    "revision_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "rules_version",
    "project_id",
    "revision",
    "stage",
    "brief",
    "concept",
    "knowledge",
    "design",
    "image_mode",
    "image_batch",
    "video",
    "audio",
    "shots",
    "image_plan",
    "assets",
    "approvals",
    "total_duration_s",
    "revision_notes"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "reference_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "shot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^shot-[0-9]{2,}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "analysis_url": {
          "type": "string",
          "pattern": "\\S"
        },
        "field_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "excerpt": {
          "type": "string"
        },
        "covered_areas": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "continuity": {
          "enum": [
            "annotated_continuous",
            "reviewed_continuous",
            "unknown",
            "cut_separated"
          ]
        },
        "access_status": {
          "enum": [
            "read",
            "failed"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "evidence_id",
        "reference_id",
        "shot_ids",
        "analysis_url",
        "field_paths",
        "excerpt",
        "covered_areas",
        "continuity",
        "access_status",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "access_status": {
                "const": "read"
              }
            }
          },
          "then": {
            "properties": {
              "shot_ids": {
                "minItems": 1
              },
              "field_paths": {
                "minItems": 1
              },
              "excerpt": {
                "type": "string",
                "pattern": "\\S"
              },
              "covered_areas": {
                "minItems": 1
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "access_status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "shot_ids": {
                "maxItems": 0
              },
              "field_paths": {
                "maxItems": 0
              },
              "excerpt": {
                "maxLength": 0
              },
              "covered_areas": {
                "maxItems": 0
              },
              "continuity": {
                "const": "unknown"
              },
              "error": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
    "approval": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "by": {
          "enum": [
            "user",
            "delegated"
          ]
        },
        "note": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "revision",
        "by",
        "note"
      ],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "translation",
            "pan",
            "orbit",
            "tilt"
          ]
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "distance_m": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "angle_deg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "description",
        "start_s",
        "duration_s",
        "distance_m",
        "angle_deg"
      ],
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "motion_relationship": {
          "enum": [
            "single",
            "simultaneous",
            "sequential"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          },
          "minItems": 1
        },
        "visible_motion_evidence": {
          "type": "string",
          "pattern": "\\S"
        },
        "timing_note": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "description",
        "motion_relationship",
        "components",
        "visible_motion_evidence",
        "timing_note"
      ],
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "properties": {
        "shot_id": {
          "type": "string",
          "pattern": "^shot-[0-9]{2,}$"
        },
        "kind": {
          "enum": [
            "exterior",
            "exterior_to_living",
            "living_to_kitchen",
            "living",
            "kitchen",
            "bedroom",
            "bathroom",
            "bathroom_laundry",
            "laundry",
            "wardrobe"
          ]
        },
        "covered_areas": {
          "type": "array",
          "items": {
            "enum": [
              "exterior",
              "living",
              "kitchen",
              "bedroom",
              "bathroom",
              "laundry",
              "wardrobe",
              "dining",
              "sleeping_loft"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "duration_s": {
          "type": "integer",
          "minimum": 1
        },
        "continuous": {
          "type": "boolean"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "framing": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "pattern": "\\S"
            },
            "end": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "camera": {
          "$ref": "#/$defs/camera"
        },
        "reference_image_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "prompt": {
          "anyOf": [
            {
              "$ref": "#/$defs/prompt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "shot_id",
        "kind",
        "covered_areas",
        "duration_s",
        "continuous",
        "evidence_ids",
        "framing",
        "camera",
        "reference_image_ids",
        "prompt"
      ],
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "properties": {
        "method": {
          "const": "R2V"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "duration_s": {
          "type": "integer",
          "minimum": 1
        },
        "reference_image_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "sections": {
          "type": "object",
          "properties": {
            "OUTPUT SPECIFICATION": {
              "type": "string",
              "pattern": "\\S"
            },
            "REFERENCE IMAGE ROLE": {
              "type": "string",
              "pattern": "\\S"
            },
            "ARCHITECTURE AND DESIGN": {
              "type": "string",
              "pattern": "\\S"
            },
            "CAMERA START COMPOSITION": {
              "type": "string",
              "pattern": "\\S"
            },
            "CAMERA MOVEMENT": {
              "type": "string",
              "pattern": "\\S"
            },
            "VISIBLE MOTION EVIDENCE": {
              "type": "string",
              "pattern": "\\S"
            },
            "ENDING COMPOSITION": {
              "type": "string",
              "pattern": "\\S"
            },
            "VISUAL CONSISTENCY LOCK": {
              "type": "string",
              "pattern": "\\S"
            },
            "CONTINUITY AND AUDIO RULES": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": [
            "OUTPUT SPECIFICATION",
            "REFERENCE IMAGE ROLE",
            "ARCHITECTURE AND DESIGN",
            "CAMERA START COMPOSITION",
            "CAMERA MOVEMENT",
            "VISIBLE MOTION EVIDENCE",
            "ENDING COMPOSITION",
            "VISUAL CONSISTENCY LOCK",
            "CONTINUITY AND AUDIO RULES"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "method",
        "revision",
        "duration_s",
        "reference_image_ids",
        "sections"
      ],
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "image_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "primary_area": {
          "enum": [
            "exterior",
            "living",
            "kitchen",
            "bedroom",
            "bathroom",
            "laundry",
            "wardrobe",
            "dining",
            "sleeping_loft"
          ]
        },
        "area_ids": {
          "type": "array",
          "items": {
            "enum": [
              "exterior",
              "living",
              "kitchen",
              "bedroom",
              "bathroom",
              "laundry",
              "wardrobe",
              "dining",
              "sleeping_loft"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "shot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^shot-[0-9]{2,}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "prompt": {
          "type": "string"
        },
        "status": {
          "enum": [
            "planned",
            "prompt_ready",
            "available",
            "reviewed",
            "failed"
          ]
        },
        "asset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "image_id",
        "primary_area",
        "area_ids",
        "shot_ids",
        "revision",
        "prompt",
        "status",
        "asset_id",
        "error"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "image_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "const": "reference"
        },
        "path": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "enum": [
            "PNG",
            "JPEG",
            "WEBP"
          ]
        },
        "reviewed": {
          "type": "boolean"
        },
        "review_origin": {
          "enum": [
            "ai_visual",
            "user_report",
            null
          ]
        },
        "review_note": {
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "image_id",
        "revision",
        "role",
        "path",
        "sha256",
        "width",
        "height",
        "format",
        "reviewed",
        "review_origin",
        "review_note"
      ],
      "additionalProperties": false
    }
  }
}
