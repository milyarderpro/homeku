{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:home-productions:project:1.0",
  "title": "home-productions project contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "rules_version": {
      "type": "string",
      "pattern": "\\S"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "stage": {
      "type": "string",
      "pattern": "\\S"
    },
    "brief": {
      "type": "string"
    },
    "concept": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "summary"
      ],
      "additionalProperties": false
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "repository_url": {
          "type": "string",
          "pattern": "\\S"
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "route": {
          "enum": [
            "web",
            "github_connector",
            null
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 0
        }
      },
      "required": [
        "repository_url",
        "ref",
        "commit",
        "route",
        "evidence"
      ],
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "properties": {
        "architecture": {
          "type": "string"
        },
        "layout": {
          "type": "string"
        },
        "materials": {
          "type": "string"
        },
        "lighting": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "anchors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "architecture",
        "layout",
        "materials",
        "lighting",
        "environment",
        "anchors"
      ],
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "pattern": "\\S"
        },
        "music": {
          "type": "boolean"
        },
        "narration": {
          "type": "boolean"
        },
        "dialogue": {
          "type": "boolean"
        },
        "dramatic_effects": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "music",
        "narration",
        "dialogue",
        "dramatic_effects"
      ],
      "additionalProperties": false
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shot"
      },
      "minItems": 0
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "minItems": 0
    },
    "approvals": {
      "type": "object",
      "properties": {
        "concept": {
          "anyOf": [
            {
              "$ref": "#/$defs/approval"
            },
            {
              "type": "null"
            }
          ]
        },
        "shot_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/approval"
            },
            {
              "type": "null"
            }
          ]
        },
        "visual": {
          "anyOf": [
            {
              "$ref": "#/$defs/approval"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "concept",
        "shot_plan",
        "visual"
      ],
      "additionalProperties": false
    },
    "total_duration_s": {
      "type": "integer",
      "minimum": 0
    },
    "revision_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "rules_version",
    "project_id",
    "revision",
    "stage",
    "brief",
    "concept",
    "knowledge",
    "design",
    "audio",
    "shots",
    "assets",
    "approvals",
    "total_duration_s",
    "revision_notes"
  ],
  "additionalProperties": false,
  "$defs": {
    "approval": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "by": {
          "enum": [
            "user",
            "delegated"
          ]
        },
        "note": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "revision",
        "by",
        "note"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "reference_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "shot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^shot-[0-9]{2,}$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "analysis_url": {
          "type": "string",
          "pattern": "\\S"
        },
        "field_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "excerpt": {
          "type": "string"
        },
        "covered_areas": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "continuity": {
          "enum": [
            "annotated_continuous",
            "reviewed_continuous",
            "unknown",
            "cut_separated"
          ]
        },
        "access_status": {
          "enum": [
            "read",
            "failed"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "evidence_id",
        "reference_id",
        "shot_ids",
        "analysis_url",
        "field_paths",
        "excerpt",
        "covered_areas",
        "continuity",
        "access_status",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "access_status": {
                "const": "read"
              }
            }
          },
          "then": {
            "properties": {
              "shot_ids": {
                "minItems": 1
              },
              "field_paths": {
                "minItems": 1
              },
              "excerpt": {
                "type": "string",
                "pattern": "\\S"
              },
              "covered_areas": {
                "minItems": 1
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "access_status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "shot_ids": {
                "maxItems": 0
              },
              "field_paths": {
                "maxItems": 0
              },
              "excerpt": {
                "maxLength": 0
              },
              "covered_areas": {
                "maxItems": 0
              },
              "continuity": {
                "const": "unknown"
              },
              "error": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
    "prompt": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "duration_s": {
          "type": "integer",
          "minimum": 1
        },
        "start_asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "end_asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "revision",
        "duration_s",
        "start_asset_id",
        "end_asset_id",
        "text"
      ],
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "properties": {
        "shot_id": {
          "type": "string",
          "pattern": "^shot-[0-9]{2,}$"
        },
        "kind": {
          "type": "string",
          "pattern": "\\S"
        },
        "covered_areas": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "duration_s": {
          "type": "integer",
          "minimum": 1
        },
        "continuous": {
          "type": "boolean"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "framing": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "pattern": "\\S"
            },
            "end": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "camera": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "pattern": "\\S"
            },
            "motion_relationship": {
              "enum": [
                "single",
                "simultaneous",
                "sequential"
              ]
            }
          },
          "required": [
            "description",
            "motion_relationship"
          ],
          "additionalProperties": false
        },
        "frames": {
          "type": "object",
          "properties": {
            "start": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "end": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "prompt": {
          "anyOf": [
            {
              "$ref": "#/$defs/prompt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "shot_id",
        "kind",
        "covered_areas",
        "duration_s",
        "continuous",
        "evidence_ids",
        "framing",
        "camera",
        "frames",
        "prompt"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "shot_id": {
          "type": "string",
          "pattern": "^shot-[0-9]{2,}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "collage",
            "start",
            "end"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "reviewed": {
          "type": "boolean"
        },
        "review_origin": {
          "enum": [
            "ai_visual",
            "user_report",
            null
          ]
        },
        "review_note": {
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "shot_id",
        "revision",
        "role",
        "path",
        "sha256",
        "width",
        "height",
        "reviewed",
        "review_origin",
        "review_note"
      ],
      "additionalProperties": false
    }
  }
}
